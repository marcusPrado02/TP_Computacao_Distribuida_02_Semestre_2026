# Copie para .env (não versionado) e troque o valor.
CLUSTER_TOKEN=troque-este-token

# Demo: rodada de ~1 s e instância TSPLIB embutida na imagem (ver PENDENCIAS.md 2.1/2.2).
# ITERATIONS_PER_ROUND=1000
# TSP_FILE=/app/data/berlin52.tsp

# Tempos de rede. Os padrões valem para loopback/compose; em LAN aumente (ver docs/LAN.md).
# RPC_TIMEOUT_MS=500
# BROADCAST_TIMEOUT_MS=2000
# COORDINATOR_TIMEOUT_MS=3000
# PEER_WAIT_MS=0
